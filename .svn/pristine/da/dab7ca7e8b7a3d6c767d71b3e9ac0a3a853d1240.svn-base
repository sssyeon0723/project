spring.application.name=BatirPlan

# 접속 URL port 설정
server.port=8060
# encodingFilter 설정
server.servlet.encoding.force=true
# JSP 설정
spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp
# log4j level 설정
logging.level.kr.or.ddit=debug

# dataSource 설정
spring.datasource.url=jdbc:oracle:thin:@112.220.114.131:1521/xe
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver
spring.datasource.username=team2_202408F
spring.datasource.password=java
# mybatis 설정
mybatis.configuration.map-underscore-to-camel-case=true
mybatis.configuration.jdbc-type-for-null=varchar
mybatis.type-aliases-package=kr.or.batirplan.vo
mybatis.mapper-locations=classpath:mybatis/mapper/**/*_SQL.xml
# FileUpload 설정
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB
spring.servlet.multipart.file-size-threshold=10MB